import pandas as pd
import numpy as np

print("--- STAGE 1: GENERATING MESSY HOSPITAL RAW DATA ---")
np.random.seed(42)
n_patients = 500  
years = [2022, 2023, 2024, 2025, 2026]

referrer_types = [
    'Internal Clinic (UK Essen Krebscenter)', 'Regional/Local Hospital (Essen Area)', 
    'External Referral (Rhine-Ruhr Partner)', 'Cooperation Partner (Münster)', 'Research Collaboration (Cologne)'
]
cities = ['Essen', 'Köln', 'Münster', 'Dortmund', 'Duisburg', 'Bochum', 'Gelsenkirchen', 'Oberhausen']
cancer_entities = ['Ocular Oncology (Eyes)', 'Gynecology', 'Pediatric Oncology', 'Lung Cancer', 'Dermatology']

simulated_data = []
for i in range(n_patients):
    patient_id = f"PAT-{20000+i}"
    year = int(np.random.choice(years, p=[0.12, 0.18, 0.25, 0.23, 0.22]))
    
    # MISTAKE 1: Typos
    c_type = np.random.choice(cancer_entities)
    if c_type == 'Gynecology' and np.random.rand() < 0.3:
        c_type = 'Gynäcology (Typo)'
    elif c_type == 'Lung Cancer' and np.random.rand() < 0.3:
        c_type = 'LungCancers'
        
    # Developement - Molecular Tumor Board
    if year >= 2025:
        tumor_stage = np.random.choice(['Stage I', 'Stage II', 'Stage III', 'Stage IV'], p=[0.10, 0.15, 0.30, 0.45])
    else:
        tumor_stage = np.random.choice(['Stage I', 'Stage II', 'Stage III', 'Stage IV'], p=[0.45, 0.30, 0.15, 0.10])
    
    # MISTAKE 2: Missing Data / NaNs) 
    if np.random.rand() < 0.08:  # 8% der Daten fehlen
        tumor_stage = None
        
    ref_type = np.random.choice(referrer_types)
    city = 'Essen' if 'Essen' in ref_type or 'Internal' in ref_type else np.random.choice(cities)
    
    # MISTAKE 3: Messy Strings on cities 
    if city == 'Essen' and np.random.rand() < 0.2:
        city = ' essen '
    elif city == 'Köln' and np.random.rand() < 0.2:
        city = 'COLOGNE'

    zip_map = {'Essen': '45122', ' essen ': '45122', 'Köln': '50667', 'COLOGNE': '50667', 'Münster': '48149', 'Dortmund': '44135', 'Duisburg': '47051', 'Bochum': '44787', 'Gelsenkirchen': '45879', 'Oberhausen': '46045'}
    postal_code = zip_map[city]
    revenue = int(np.random.randint(2500, 6000) if tumor_stage in ['Stage I', 'Stage II', None] else np.random.randint(6500, 14000))
    board_type = 'Molecular Tumor Board' if year >= 2025 and tumor_stage in ['Stage III', 'Stage IV'] else 'Standard Tumor Board'
    current_bottleneck = 'None (Smooth Routing)' if board_type == 'Molecular Tumor Board' else 'Severe Staff Shortage'
    waiting_time = int(np.random.normal(3.2, 0.8)) if board_type == 'Molecular Tumor Board' else int(np.random.normal(16.0, 2.0))

    simulated_data.append({
        'patient_id': patient_id, 'year': year, 'referrer_type': ref_type, 'city': city,
        'postal_code': postal_code, 'cancer_type': c_type, 'tumor_stage': tumor_stage,
        'board_type': board_type, 'bottleneck_reason': current_bottleneck, 'waiting_time_days': max(1, waiting_time), 'revenue_euros': revenue
    })

df_dirty = pd.DataFrame(simulated_data)
print(f"[STAGE 1 SUCCESS] Uncleaned Raw Data Frame created with {df_dirty['tumor_stage'].isna().sum()} missing stages.")

#Code-Block 2: STAGE 2 – Automated Data Cleaning 

print("\n--- STAGE 2: EXECUTION OF AUTOMATED DATA CLEANING (THE ESSENTIAL SKILLS) ---")

# REPAIR 1: Typos (Mapping)
df_dirty['cancer_type'] = df_dirty['cancer_type'].replace({'Gynäcology (Typo)': 'Gynecology', 'LungCancers': 'Lung Cancer'})
